{
  "name": "dev-squash-merge",
  "target": "branch",
  "enforcement": "active",
  "conditions": {
    "ref_name": {
      "include": ["refs/heads/dev"],
      "exclude": []
    }
  },
  "rules": [
    {
      "type": "pull_request",
      "parameters": {
        "required_merge_method": "squash"
      }
    },
    {
      "type": "required_linear_history"
    }
  ]
}
